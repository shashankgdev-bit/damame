    "url": "git+https://github.com/shashankgdev-bit/damame.git"
  },
  "devDependencies": {
    "@damame/adapter-claude-code": "*",
    "@damame/ir": "*",
    "@damame/metrics": "*",
    "@damame/report-html": "*",
    "@damame/rules": "*",
    "commander": "^13.0.0",
    "picocolors": "^1.1.0",
    "@damame/profile": "*"
  }
}
