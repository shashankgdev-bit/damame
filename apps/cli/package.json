{
  "name": "damame",
  "version": "0.3.0",
  "description": "A profiler for your AI coding sessions — evidence-linked, deterministic, local-first.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "damame": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && cp src/ui/app.html dist/app.html",
